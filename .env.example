# Copy to `.env` and adjust. `.env` is gitignored and must never be committed.
#
# Docker Compose reads .env automatically; these feed docker-compose.yml.

# Local database password. Local-only — production credentials come from the
# deployment environment, never from a file in the repository.
POSTGRES_PASSWORD=localdev

# Change if 5432 is taken by another Postgres on this machine.
POSTGRES_PORT=5432
