# --- Build output (regenerable — never commit) ---
build/
out/
bin/
!gradle/wrapper/gradle-wrapper.jar

# --- Gradle local state ---
.gradle/

# --- Secrets (NEVER commit — see .env.example for the shape) ---
.env
.env.local
*.pem
*.key
application-local.yml

# --- IDE ---
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# --- OS noise ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs ---
*.log
logs/
data/photos/

# Production config, created on the server from the examples in the repo.
# nt.env holds database and email credentials; Caddyfile holds your real
# domain. Neither belongs in version control.
nt.env
Caddyfile

# Diagnostics written by deploy.sh when a deploy leaves the site unreachable.
# Worth reading and worth keeping off the repository.
deploy-failure-*.log
